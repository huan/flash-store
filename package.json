{
  "name": "flash-store",
  "version": "2.0.0",
  "description": "Persistent Map-like storage backed by LMDB.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/mod.d.ts",
      "import": "./dist/src/mod.js"
    }
  },
  "types": "./dist/src/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc && node scripts/prepare-package.ts",
    "prepack": "npm run build",
    "demo": "node example/demo.ts",
    "lint": "biome check src example scripts tsconfig.json package.json biome.json coverage-baselines.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "test:unit": "node --test src/*.test.ts",
    "test:deno": "deno test --no-check --allow-read --allow-write --allow-env --allow-ffi --allow-sys=homedir src/",
    "coverage:node": "node scripts/coverage.ts node",
    "coverage:deno": "node scripts/coverage.ts deno",
    "test:pack": "node scripts/pack-test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huan/flash-store.git"
  },
  "keywords": [
    "lmdb",
    "nosql",
    "database"
  ],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/huan/flash-store/issues"
  },
  "homepage": "https://github.com/huan/flash-store#readme",
  "dependencies": {
    "brolog": "^1.14.2",
    "lmdb": "^3.5.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/src/",
    "!dist/src/*.test.*",
    "dist/package.json"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
